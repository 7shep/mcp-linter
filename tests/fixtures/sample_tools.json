{
  "tools": [
    {
      "name": "search_contacts",
      "description": "Search the user's contacts by name, email, or company. Returns up to 'limit' matches with name, email, and company, most recently contacted first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Text to match against name, email, or company."},
          "limit": {"type": "integer", "description": "Maximum results to return (1-50, default 10)."}
        },
        "required": ["query"]
      }
    },
    {
      "name": "get_user",
      "description": "Gets a user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {"type": "string"},
          "fields": {"description": "Comma-separated fields to include."}
        }
      }
    },
    {
      "name": "delete_thing",
      "inputSchema": {"type": "object", "properties": {}}
    }
  ]
}
